   "source": [
    "psy = pd.read_excel(DATA / 'Психологи.xlsx')\n",
    "psy.columns = psy.columns.str.strip()\n",
    "psy['пол'] = psy['пол'].str.strip().str.lower()\n",
    "display(psy.head())\n",
    "display(psy['пол'].value_counts())\n",
    "display(psy.isna().sum())\n",
    "psy_cols = [c for c in psy.select_dtypes('number').columns if c not in ['учащиеся', 'профиль ВУЗа']]\n",
    "psy_tests = compare_groups(psy, 'пол', psy_cols, 'м', 'ж')\n",
    "display(psy_tests.sort_values('p'))\n",
    "normal_psy = []\n",
    "for c in psy_cols:\n",
    "    for g in ['м', 'ж']:\n",
    "        x = psy.loc[psy['пол'].eq(g), c].dropna()\n",
    "        normal_psy.append([c, g, len(x), stats.shapiro(x).pvalue])\n",
    "display(pd.DataFrame(normal_psy, columns=['шкала', 'пол', 'n', 'p_Shapiro']))\n",
    "psy_tests.to_csv(DATA / 'psychology_welch.csv', index=False)"
   ]
  },
  {
