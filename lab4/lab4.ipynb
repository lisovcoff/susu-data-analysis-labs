    "def holm(pvalues):\n",
    "    p = np.asarray(pvalues)\n",
    "    order = np.argsort(p)\n",
    "    adjusted = np.empty(len(p))\n",
    "    adjusted[order] = np.minimum(1, np.maximum.accumulate((len(p) - np.arange(len(p))) * p[order]))\n",
    "    return adjusted\n",
    "\n",
    "def compare_groups(frame, group, cols, a, b):\n",
    "    rows = []\n",
    "    for col in cols:\n",
    "        x = frame.loc[frame[group].eq(a), col].dropna().to_numpy()\n",
    "        y = frame.loc[frame[group].eq(b), col].dropna().to_numpy()\n",
    "        t, p = stats.ttest_ind(x, y, equal_var=False)\n",
    "        diff = x.mean() - y.mean()\n",
    "        vx = x.var(ddof=1) / len(x)\n",
    "        vy = y.var(ddof=1) / len(y)\n",
    "        se = np.sqrt(vx + vy)\n",
    "        dof = (vx + vy) ** 2 / (vx * vx / (len(x) - 1) + vy * vy / (len(y) - 1))\n",
    "        margin = stats.t.ppf(0.975, dof) * se\n",
    "        pooled = np.sqrt(((len(x) - 1) * x.var(ddof=1) + (len(y) - 1) * y.var(ddof=1)) / (len(x) + len(y) - 2))\n",
    "        rows.append([col, len(x), len(y), x.mean(), y.mean(), diff, t, p, diff - margin, diff + margin, diff / pooled])\n",
    "    r = pd.DataFrame(rows, columns=['показатель', 'n_A', 'n_B', 'mean_A', 'mean_B', 'A-B', 't', 'p', 'CI_low', 'CI_high', 'Cohen_d'])\n",
    "    r['значимо без поправки'] = r.p < 0.05\n",
    "    r['p_Holm'] = holm(r.p)\n",
    "    r['вывод_0.05'] = np.where(r.p_Holm < 0.05, 'H0 отклонена', 'H0 не отклонена')\n",
    "    return r\n",
    "birth_tests = compare_groups(birth, 'pol(1-м, 0-д)', ['rost', 'ves', 'ИМТ'], 1, 0)\n",
    "display(birth_tests)\n",
    "birth_tests.to_csv(DATA / 'birth_welch.csv', index=False)"
   ]
  },
