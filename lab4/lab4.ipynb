   "source": [
    "birth = pd.read_excel(DATA / 'Пренатальная диагностика.xlsx', sheet_name='исходные данные')\n",
    "display(birth.head())\n",
    "display(birth.isna().sum())\n",
    "display(birth['pol(1-м, 0-д)'].value_counts().rename(index={0: 'девочки', 1: 'мальчики'}))\n",
    "assert set(birth['pol(1-м, 0-д)'].unique()) <= {0, 1}\n",
    "birth['ИМТ'] = birth.ves / 1000 / (birth.rost / 100) ** 2\n",
    "num = [c for c in birth.select_dtypes('number').columns if c != 'pol(1-м, 0-д)']\n",
    "descr = birth[num].describe().T\n",
    "descr['range'] = birth[num].max() - birth[num].min()\n",
    "descr['median'] = birth[num].median()\n",
    "display(descr)"
   ]
